// Enemies. hp is the base value before act/floor/ascension scaling. speed in tiles/second.
// armor: flat reduction of PHYSICAL damage per hit (at least 25% always gets through).
// resist: percentage reduction per damage type (negative = weakness).
// abilities: data-driven behaviours, see battle/ability/AbilityFactory.java.
[
  // ---------------- Act 1: The Greenwood ----------------
  { "id": "grunt", "name": "Goblin Grunt", "description": "Basic infantry.",
    "hp": 30, "speed": 1.15, "leak": 1, "mana": 3, "shape": "circle", "color": "#d65a4a" },
  { "id": "runner", "name": "Wolf Runner", "description": "Very fast. Resists slows.",
    "hp": 20, "speed": 2.1, "leak": 1, "mana": 2, "shape": "triangle", "color": "#e0a040", "radius": 0.24,
    "statusResist": { "slow": 0.3 } },
  { "id": "brute", "name": "Orc Brute", "description": "Slow and armored. Weak to slows.",
    "hp": 110, "speed": 0.75, "armor": 4, "leak": 3, "mana": 7, "shape": "square", "color": "#6aa04a", "radius": 0.34,
    "statusResist": { "slow": -0.2 } },
  { "id": "shaman", "name": "Goblin Shaman", "description": "Periodically heals nearby enemies.",
    "hp": 50, "speed": 1.0, "leak": 1, "mana": 6, "shape": "diamond", "color": "#b070e0",
    "abilities": [ { "type": "healAura", "radius": 1.8, "pct": 0.08, "interval": 3 } ] },
  { "id": "bat", "name": "Cave Bat", "description": "Flying: ignores the path. Only some towers can hit it.",
