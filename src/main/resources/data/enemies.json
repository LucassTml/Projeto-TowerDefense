  { "id": "colossus", "name": "Ashen Colossus", "description": "Final boss. Stomps towers, summons imps, enrages and shields itself in phases.",
    "hp": 5000, "speed": 0.38, "armor": 14, "leak": 16, "mana": 150, "shape": "star", "color": "#5a2a20",
    "radius": 0.6, "boss": true,
    "resist": { "fire": 0.4 }, "statusResist": { "slow": 0.6, "freeze": 0.9 },
    "abilities": [
      { "type": "disableTowers", "radius": 2.5, "duration": 2.5, "interval": 8, "initialDelay": 4 },
      { "type": "summon", "enemy": "imp", "count": 3, "interval": 6, "initialDelay": 3 },
      { "type": "enrage", "threshold": 0.3, "speedMult": 1.8 },
      { "type": "phases", "thresholds": [0.75, 0.5, 0.25], "duration": 2, "summon": "magma_brute", "count": 1 }
    ] }
