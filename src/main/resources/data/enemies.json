  { "id": "shieldbearer", "name": "Shield Bearer", "description": "Regenerating shield absorbs damage.",
    "hp": 60, "speed": 0.95, "armor": 2, "leak": 2, "mana": 6, "shape": "hexagon", "color": "#7aa0c0", "radius": 0.3,
    "abilities": [ { "type": "shield", "pct": 0.6, "delay": 3, "rate": 0.25 } ] },
  { "id": "spiderling", "name": "Spiderling", "description": "Tiny and quick.",
    "hp": 10, "speed": 1.8, "leak": 1, "mana": 1, "shape": "circle", "color": "#4a4a52", "radius": 0.16 },
  { "id": "broodmother", "name": "Brood Mother", "description": "Bursts into spiderlings when killed.",
    "hp": 130, "speed": 0.8, "leak": 3, "mana": 10, "shape": "hexagon", "color": "#7a5a8a", "radius": 0.36,
    "abilities": [ { "type": "splitOnDeath", "enemy": "spiderling", "count": 4 } ] },
  { "id": "warlord", "name": "Orc Warlord", "description": "Summons grunts, becomes invulnerable at 66% and 33% HP and enrages below 50%.",
    "hp": 1300, "speed": 0.5, "armor": 6, "leak": 12, "mana": 60, "shape": "star", "color": "#c0392b",
    "radius": 0.48, "boss": true, "statusResist": { "freeze": 0.6, "slow": 0.3 },
    "abilities": [
      { "type": "summon", "enemy": "grunt", "count": 3, "interval": 7, "initialDelay": 4 },
      { "type": "enrage", "threshold": 0.5, "speedMult": 1.6 },
      { "type": "phases", "thresholds": [0.66, 0.33], "duration": 2.5, "summon": "brute", "count": 2 }
    ] },

  // ---------------- Act 2: The Frostmarch ----------------
  { "id": "yeti", "name": "Yeti", "description": "Tough and regenerates health.",
