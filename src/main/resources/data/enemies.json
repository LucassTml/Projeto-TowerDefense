    "resist": { "frost": 0.6 }, "statusResist": { "freeze": 0.8, "slow": 0.4 },
    "abilities": [
      { "type": "disableTowers", "radius": 2.2, "duration": 3, "interval": 9, "initialDelay": 5 },
      { "type": "phases", "thresholds": [0.5], "duration": 3, "summon": "frost_drake", "count": 3 },
      { "type": "regen", "pct": 0.004 }
    ] },

  // ---------------- Act 3: The Ashen Wastes ----------------
  { "id": "imp", "name": "Fire Imp", "description": "Fast and immune-ish to fire.",
    "hp": 60, "speed": 1.9, "leak": 1, "mana": 3, "shape": "triangle", "color": "#ff6a3d", "radius": 0.22,
    "resist": { "fire": 0.7 } },
  { "id": "magma_brute", "name": "Magma Brute", "description": "Massive armor, regenerates. Weak to frost.",
    "hp": 400, "speed": 0.62, "armor": 12, "leak": 4, "mana": 14, "shape": "square", "color": "#b5452a", "radius": 0.42,
    "resist": { "fire": 0.5, "frost": -0.3 },
    "abilities": [ { "type": "regen", "pct": 0.01 } ] },
  { "id": "warlock", "name": "Ash Warlock", "description": "Summons imps and shields itself.",
    "hp": 160, "speed": 0.95, "leak": 2, "mana": 10, "shape": "diamond", "color": "#7a2a5a",
    "resist": { "arcane": 0.3 },
    "abilities": [ { "type": "summon", "enemy": "imp", "count": 2, "interval": 6, "initialDelay": 2 },
